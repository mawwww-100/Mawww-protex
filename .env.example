# WAJIB — generate dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Railway akan otomatis inject ini, jangan diisi manual
# PORT=3000

# Path database — di Railway gunakan volume mount
# Kalau ada volume di /data, set ke /data/mawww.db
DATABASE_PATH=./mawww.db

NODE_ENV=production
